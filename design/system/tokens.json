{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Warden: fonte única dos tokens de design (direção Deep Dark). Edite só este arquivo e rode `node design/system/tools/build-tokens.mjs`, que gera tokens.css, tailwind-theme.css e shadcn-theme.css. Referências entre chaves usam a sintaxe {grupo.nome}. Os nomes de saída seguem os namespaces do Tailwind CSS 4 (--color-*, --font-*, --text-*, --radius-*, --shadow-*, --ease-*), para virar tema sem tradução.",
  "palette": {
    "$description": "Cores cruas. Componentes NUNCA usam a paleta direto: usam os papéis em `color`.",
    "abismo-950": { "$type": "color", "$value": "#03090c", "$description": "Fundo afundado: campos, console, poços" },
    "abismo-900": { "$type": "color", "$value": "#050d12", "$description": "Fundo do Deep Dark" },
    "sculk-900": { "$type": "color", "$value": "#0a1a21", "$description": "Painel" },
    "sculk-800": { "$type": "color", "$value": "#0e2630", "$description": "Corpo do Warden: superfície elevada" },
    "sculk-700": { "$type": "color", "$value": "#12313c", "$description": "Superfície mais alta, trilhos" },
    "sculk-650": { "$type": "color", "$value": "#15333e", "$description": "Divisórias" },
    "sculk-600": { "$type": "color", "$value": "#1e4552", "$description": "Bordas de painel" },
    "sculk-400": { "$type": "color", "$value": "#4f8a98", "$description": "Contorno de controles" },
    "alma-300": { "$type": "color", "$value": "#7ff3f0", "$description": "Brilho claro (partículas, pontas das antenas)" },
    "alma-400": { "$type": "color", "$value": "#5fe3ec", "$description": "Ciano como texto" },
    "alma-500": { "$type": "color", "$value": "#19d3e0", "$description": "Brilho de sculk: destaque" },
    "alma-600": { "$type": "color", "$value": "#0fb5c2", "$description": "Destaque ao passar o mouse" },
    "alma-700": { "$type": "color", "$value": "#0a8f9a", "$description": "Destaque pressionado" },
    "alma-950": { "$type": "color", "$value": "#021418", "$description": "Texto sobre o ciano" },
    "osso-200": { "$type": "color", "$value": "#cfe3da", "$description": "Costelas do Warden: foco, IA, detalhes" },
    "nevoa-100": { "$type": "color", "$value": "#e4f3ef", "$description": "Texto principal" },
    "nevoa-300": { "$type": "color", "$value": "#b4cfca", "$description": "Texto secundário" },
    "nevoa-500": { "$type": "color", "$value": "#8aacaa", "$description": "Texto apagado" },
    "verde-500": { "$type": "color", "$value": "#3ddc84" },
    "verde-300": { "$type": "color", "$value": "#6be7a2" },
    "ambar-500": { "$type": "color", "$value": "#f2b33d" },
    "ambar-300": { "$type": "color", "$value": "#ffcb66" },
    "vermelho-500": { "$type": "color", "$value": "#ff5c5c" },
    "vermelho-300": { "$type": "color", "$value": "#ff8e8e" },
    "vermelho-700": { "$type": "color", "$value": "#c42f35" },
    "lavanda-500": { "$type": "color", "$value": "#b3a6ff" },
    "lavanda-300": { "$type": "color", "$value": "#c6bcff" },
    "laranja-500": { "$type": "color", "$value": "#f48a4a" },
    "branco": { "$type": "color", "$value": "#ffffff" },
    "preto-pixel": { "$type": "color", "$value": "#010507" }
  },
  "color": {
    "$description": "Papéis de cor. Saída: --color-<nome>.",
    "bg": { "$type": "color", "$value": "{palette.abismo-900}", "$description": "Fundo da janela" },
    "bg-sunken": { "$type": "color", "$value": "{palette.abismo-950}", "$description": "Campos, console, áreas afundadas (slot)" },
    "surface-1": { "$type": "color", "$value": "{palette.sculk-900}", "$description": "Painéis, cabeçalhos, menus" },
    "surface-2": { "$type": "color", "$value": "{palette.sculk-800}", "$description": "Botão secundário, linha em hover, cartão elevado" },
    "surface-3": { "$type": "color", "$value": "{palette.sculk-700}", "$description": "Hover sobre surface-2, trilhos de progresso" },
    "overlay": { "$type": "color", "$value": "rgba(2, 7, 10, 0.78)", "$description": "Fundo atrás de diálogos" },
    "border": { "$type": "color", "$value": "{palette.sculk-650}", "$description": "Divisórias e linhas de tabela" },
    "border-strong": { "$type": "color", "$value": "{palette.sculk-600}", "$description": "Borda de painel e de botão secundário" },
    "border-control": { "$type": "color", "$value": "{palette.sculk-400}", "$description": "Contorno de campos (3:1 contra o fundo)" },
    "text": { "$type": "color", "$value": "{palette.nevoa-100}", "$description": "Texto principal" },
    "text-2": { "$type": "color", "$value": "{palette.nevoa-300}", "$description": "Texto secundário, descrições" },
    "text-3": { "$type": "color", "$value": "{palette.nevoa-500}", "$description": "Metadados, placeholders" },
    "bone": { "$type": "color", "$value": "{palette.osso-200}", "$description": "Detalhe em osso: separadores de destaque, marcador de IA" },
    "primary": { "$type": "color", "$value": "{palette.alma-500}", "$description": "Ação principal, seleção, progresso, Testar" },
    "primary-hover": { "$type": "color", "$value": "{palette.alma-600}" },
    "primary-press": { "$type": "color", "$value": "{palette.alma-700}" },
    "on-primary": { "$type": "color", "$value": "{palette.alma-950}", "$description": "Texto e ícone sobre o ciano" },
    "primary-text": { "$type": "color", "$value": "{palette.alma-400}", "$description": "Ciano usado como texto ou link" },
    "primary-bright": { "$type": "color", "$value": "{palette.alma-300}", "$description": "Pontas acesas (antenas, partículas). Nunca para texto" },
    "primary-soft": { "$type": "color", "$value": "rgba(25, 211, 224, 0.12)", "$description": "Fundo de item selecionado" },
    "primary-line": { "$type": "color", "$value": "rgba(25, 211, 224, 0.4)", "$description": "Contorno de item selecionado" },
    "primary-glow": { "$type": "color", "$value": "rgba(25, 211, 224, 0.45)", "$description": "Cor do brilho (só em estado ativo)" },
    "focus": { "$type": "color", "$value": "{palette.osso-200}", "$description": "Anel de foco do teclado. Osso, para não se confundir com o ciano de seleção" },
    "ok": { "$type": "color", "$value": "{palette.verde-500}", "$description": "Marcador de sucesso (ícone, barra)" },
    "ok-text": { "$type": "color", "$value": "{palette.verde-300}" },
    "ok-soft": { "$type": "color", "$value": "rgba(61, 220, 132, 0.12)" },
    "warn": { "$type": "color", "$value": "{palette.ambar-500}" },
    "warn-text": { "$type": "color", "$value": "{palette.ambar-300}" },
    "warn-soft": { "$type": "color", "$value": "rgba(242, 179, 61, 0.12)" },
    "danger": { "$type": "color", "$value": "{palette.vermelho-500}" },
    "danger-text": { "$type": "color", "$value": "{palette.vermelho-300}" },
    "danger-soft": { "$type": "color", "$value": "rgba(255, 92, 92, 0.13)" },
    "danger-solid": { "$type": "color", "$value": "{palette.vermelho-700}", "$description": "Fundo do botão de perigo" },
    "on-danger": { "$type": "color", "$value": "{palette.branco}" },
    "info": { "$type": "color", "$value": "{palette.lavanda-500}", "$description": "Informação. Lavanda para nunca se confundir com o ciano" },
    "info-text": { "$type": "color", "$value": "{palette.lavanda-300}" },
    "info-soft": { "$type": "color", "$value": "rgba(179, 166, 255, 0.12)" },
    "ai": { "$type": "color", "$value": "{palette.osso-200}", "$description": "Tudo que é IA: ícone sparkles, borda do bloco de resposta" },
    "ai-soft": { "$type": "color", "$value": "rgba(207, 227, 218, 0.07)" },
    "ai-line": { "$type": "color", "$value": "rgba(207, 227, 218, 0.45)" },
    "src-modrinth": { "$type": "color", "$value": "{palette.verde-500}", "$description": "Marcador redondo da fonte Modrinth" },
    "src-curseforge": { "$type": "color", "$value": "{palette.laranja-500}", "$description": "Marcador em losango da fonte CurseForge" },
    "src-local": { "$type": "color", "$value": "{palette.nevoa-500}", "$description": "Marcador quadrado de arquivo local" },
    "diff-add": { "$type": "color", "$value": "rgba(61, 220, 132, 0.14)" },
    "diff-del": { "$type": "color", "$value": "rgba(255, 92, 92, 0.14)" },
    "console-bg": { "$type": "color", "$value": "#020709" },
    "console-text": { "$type": "color", "$value": "#cfe6e1" },
    "console-muted": { "$type": "color", "$value": "#86a9a6" },
    "pixel-shadow": { "$type": "color", "$value": "{palette.preto-pixel}", "$description": "Sombra dura dos textos em fonte pixel" },
    "bevel-light": { "$type": "color", "$value": "rgba(255, 255, 255, 0.2)" },
    "bevel-dark": { "$type": "color", "$value": "rgba(0, 0, 0, 0.34)" }
  },
  "font": {
    "$description": "Famílias. Saída: --font-<nome>. Todas SIL OFL 1.1, embutidas no app (design/system/fonts).",
    "display": { "$type": "fontFamily", "$value": ["Pixelify Sans", "Manrope", "system-ui", "sans-serif"], "$description": "Pixel: títulos curtos, menu de seções, botão Testar, números" },
    "ui": { "$type": "fontFamily", "$value": ["Manrope", "Segoe UI", "system-ui", "sans-serif"], "$description": "Todo o texto de leitura e os controles" },
    "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "Cascadia Mono", "Consolas", "monospace"], "$description": "Console, versões, caminhos, configs" }
  },
  "text": {
    "$description": "Escala de tamanhos (app desktop denso, base 14px). Saída: --text-<nome> e --text-<nome>--line-height.",
    "2xs": { "$type": "dimension", "$value": "11px", "lineHeight": "14px", "$description": "Selos em caixa alta" },
    "xs": { "$type": "dimension", "$value": "12px", "lineHeight": "16px", "$description": "Metadados, legendas" },
    "sm": { "$type": "dimension", "$value": "13px", "lineHeight": "18px", "$description": "Tabelas, descrições" },
    "base": { "$type": "dimension", "$value": "14px", "lineHeight": "20px", "$description": "Corpo do app" },
    "md": { "$type": "dimension", "$value": "16px", "lineHeight": "22px", "$description": "Itens do menu de seções (pixel), destaque" },
    "lg": { "$type": "dimension", "$value": "20px", "lineHeight": "24px", "$description": "Título de bloco (pixel) e de diálogo (sans)" },
    "xl": { "$type": "dimension", "$value": "24px", "lineHeight": "28px", "$description": "Título de tela e nome do pack (pixel)" },
    "2xl": { "$type": "dimension", "$value": "32px", "lineHeight": "36px", "$description": "Números grandes e boas-vindas (pixel)" }
  },
  "font-weight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold": { "$type": "fontWeight", "$value": 700 },
    "extrabold": { "$type": "fontWeight", "$value": 800 }
  },
  "tracking": {
    "display": { "$type": "dimension", "$value": "0.02em" },
    "caps": { "$type": "dimension", "$value": "0.06em" }
  },
  "space": {
    "$description": "Base 4px. Saída: --spacing (base do Tailwind) e --space-<n>.",
    "base": { "$type": "dimension", "$value": "4px" },
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "$description": "O Warden não arredonda: usa cantos retos e o degrau de pixel. Saída: --radius-<nome>.",
    "none": { "$type": "dimension", "$value": "0px" },
    "xs": { "$type": "dimension", "$value": "2px", "$description": "Campos e linhas selecionadas" },
    "sm": { "$type": "dimension", "$value": "4px", "$description": "Painéis grandes (raro)" }
  },
  "notch": {
    "$description": "Tamanho do degrau de pixel recortado nos cantos (clip-path). Saída: --notch-<nome>.",
    "md": { "$type": "dimension", "$value": "4px", "$description": "Botões md/lg, diálogos, Testar" },
    "sm": { "$type": "dimension", "$value": "2px", "$description": "Botões sm, selos, campos" }
  },
  "border-width": {
    "thin": { "$type": "dimension", "$value": "1px" },
    "block": { "$type": "dimension", "$value": "2px", "$description": "Bordas de bloco: diálogos, menus, progresso" },
    "bar": { "$type": "dimension", "$value": "3px", "$description": "Barra de seleção e de alerta" }
  },
  "shadow": {
    "$description": "Elevação em blocos: sombra dura deslocada para baixo, quase sem desfoque. Saída: --shadow-<nome> / --inset-shadow-<nome>.",
    "block-1": { "$type": "shadow", "$value": "0 2px 0 rgba(0, 0, 0, 0.5)", "$description": "Cartão, linha destacada" },
    "block-2": { "$type": "shadow", "$value": "0 4px 0 rgba(0, 0, 0, 0.5), 0 10px 24px rgba(0, 0, 0, 0.4)", "$description": "Menus, painel lateral, toast" },
    "block-3": { "$type": "shadow", "$value": "0 8px 0 rgba(0, 0, 0, 0.5), 0 24px 64px rgba(0, 0, 0, 0.6)", "$description": "Diálogos" },
    "bevel": { "$type": "shadow", "$value": "inset 0 2px 0 rgba(255, 255, 255, 0.2), inset 0 -3px 0 rgba(0, 0, 0, 0.34)", "$description": "Chanfro de bloco nos botões", "inset": true },
    "bevel-press": { "$type": "shadow", "$value": "inset 0 3px 0 rgba(0, 0, 0, 0.34)", "$description": "Botão pressionado", "inset": true },
    "slot": { "$type": "shadow", "$value": "inset 2px 2px 0 rgba(0, 0, 0, 0.5), inset -1px -1px 0 rgba(127, 243, 240, 0.06)", "$description": "Campo e item ativo afundados, como um slot de inventário", "inset": true },
    "glow": { "$type": "shadow", "$value": "0 0 0 1px rgba(25, 211, 224, 0.55), 0 0 18px rgba(25, 211, 224, 0.28)", "$description": "Brilho de sensor: só em ativo/selecionado" },
    "pixel-text": { "$type": "shadow", "$value": "2px 2px 0 #010507", "$description": "Sombra dura de texto pixel (text-shadow)" }
  },
  "duration": {
    "$description": "Saída: --duration-<nome>. Com prefers-reduced-motion, todas viram 0 e o pulso para.",
    "instant": { "$type": "duration", "$value": "80ms" },
    "fast": { "$type": "duration", "$value": "120ms", "$description": "Hover, foco, cor" },
    "base": { "$type": "duration", "$value": "200ms", "$description": "Abrir menu, toast" },
    "slow": { "$type": "duration", "$value": "320ms", "$description": "Painel lateral, diálogo" },
    "pulse": { "$type": "duration", "$value": "3400ms", "$description": "Pulso do sensor do Testar" }
  },
  "ease": {
    "out": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1], "$description": "Entradas" },
    "in-out": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1], "$description": "Pulso e movimentos contínuos" },
    "pixel": { "$type": "other", "$value": "steps(4, end)", "$description": "Animações em degraus (carregador em blocos, progresso indeterminado)" }
  },
  "size": {
    "$description": "Medidas de controle e de layout. Saída: --size-<nome>.",
    "control-sm": { "$type": "dimension", "$value": "28px" },
    "control-md": { "$type": "dimension", "$value": "36px" },
    "control-lg": { "$type": "dimension", "$value": "48px" },
    "icon-sm": { "$type": "dimension", "$value": "14px" },
    "icon-md": { "$type": "dimension", "$value": "16px" },
    "icon-lg": { "$type": "dimension", "$value": "20px" },
    "topbar": { "$type": "dimension", "$value": "56px", "$description": "Barra do nível do app" },
    "pack-header": { "$type": "dimension", "$value": "76px", "$description": "Cabeçalho fixo do pack" },
    "section-menu": { "$type": "dimension", "$value": "252px", "$description": "Menu de seções do pack" },
    "statusbar": { "$type": "dimension", "$value": "30px", "$description": "Rodapé com o indicador de Tarefas" },
    "drawer": { "$type": "dimension", "$value": "440px", "$description": "Painel lateral" },
    "dialog-sm": { "$type": "dimension", "$value": "480px" },
    "dialog-md": { "$type": "dimension", "$value": "600px" },
    "dialog-lg": { "$type": "dimension", "$value": "780px" },
    "content-max": { "$type": "dimension", "$value": "1180px", "$description": "Largura máxima da área de conteúdo" },
    "window-min-w": { "$type": "dimension", "$value": "1024px", "$description": "Menor janela suportada" }
  },
  "z": {
    "$description": "Camadas. Saída: --z-<nome>.",
    "header": { "$type": "number", "$value": 10 },
    "dropdown": { "$type": "number", "$value": 30 },
    "drawer": { "$type": "number", "$value": 40 },
    "dialog": { "$type": "number", "$value": 50 },
    "toast": { "$type": "number", "$value": 60 },
    "tooltip": { "$type": "number", "$value": 70 }
  }
}
