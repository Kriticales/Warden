{
	"schema_version": 1,
	"quilt_loader": {
		"group": "org.quiltmc.qsl.item",
		"id": "quilt_item_content_registry",
		"version": "6.3.0+1.20.1",
		"metadata": {
			"name": "Quilt Item Content Registry API",
			"description": "An API for adding to different content registries in Minecraft",
			"contributors": {
				"The Quilt Project": "Owner"
			},
			"contact": {
				"homepage": "https://quiltmc.org",
				"issues": "https://github.com/QuiltMC/quilt-standard-libraries/issues",
				"sources": "https://github.com/QuiltMC/quilt-standard-libraries"
			},
			"license": "Apache-2.0",
			"icon": "assets/quilt_item_content_registry/icon.png"
		},
		"intermediate_mappings": "net.fabricmc:intermediary",
		"load_type": "if_possible",
		"depends": [
			{
				"id": "quilt_loader",
				"versions": ">=0.25.0"
			},
			{
				"id": "minecraft",
				"versions": {
					"any": [
						"=1.20.1",
						"=1.20"
					]
				}
			},
			{
				"id": "quilt_base",
				"versions": ">=6.3.0+1.20.1"
			},
			{
				"id": "quilt_resource_loader",
				"versions": ">=6.3.0+1.20.1"
			},
			{
				"id": "quilt_registry_entry_attachment",
				"versions": ">=6.3.0+1.20.1"
			},
			{
				"id": "quilt_tooltip",
				"versions": ">=6.3.0+1.20.1",
				"optional": true
			}
		],
		"entrypoints": {
			"client_init": [
				"org.quiltmc.qsl.item.content.registry.impl.ItemContentRegistriesClientInitializer"
			],
			"init": [
				"org.quiltmc.qsl.item.content.registry.impl.ItemContentRegistriesInitializer"
			]
		}
	},
	"mixin": "quilt_item_content_registry.mixins.json",
	"modmenu": {
		"badges": [
			"library"
		],
		"parent": {
			"id": "qsl",
			"name": "Quilt Standard Libraries",
			"description": "A set of libraries to assist in making Quilt mods.",
			"icon": "assets/quilt_item_content_registry/icon.png",
			"badges": [
				"library"
			]
		}
	}
}