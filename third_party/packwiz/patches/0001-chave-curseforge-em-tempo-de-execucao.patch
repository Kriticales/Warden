+	"os"
 	"strconv"
+	"strings"
 	"time"
@@ -20,11 +22,16 @@
 
-// Exists so you can provide it as a build parameter: -ldflags="-X 'github.com/packwiz/packwiz/curseforge.cfApiKey=key'"
-var cfApiKey = ""
+// Warden: a chave da CurseForge vem da variável de ambiente abaixo, lida a cada requisição.
+// Não há recuo para a chave embutida acima (pedido do autor do packwiz a projetos derivados;
+// ADR-0007 do Warden): cfApiKeyDefault não é mais usada, e o Go não a grava no executável.
+const cfApiKeyEnv = "WARDEN_CURSEFORGE_API_KEY"
 
-func decodeDefaultKey() string {
-	k, err := base64.StdEncoding.DecodeString(cfApiKeyDefault)
-	if err != nil {
-		panic("failed to read API key!")
+var errNoCfApiKey = errors.New("WARDEN_CURSEFORGE_API_KEY ausente: a chave da CurseForge não foi informada. " +
+	"Defina a variável de ambiente WARDEN_CURSEFORGE_API_KEY com a sua chave da API da CurseForge")
+
+func cfApiKey() (string, error) {
+	key := strings.TrimSpace(os.Getenv(cfApiKeyEnv))
+	if key == "" {
+		return "", errNoCfApiKey
 	}
-	return string(k)
+	return key, nil
 }
@@ -45,6 +52,7 @@
 	req.Header.Set("Accept", "application/json")
-	if cfApiKey == "" {
-		cfApiKey = decodeDefaultKey()
+	key, err := cfApiKey()
+	if err != nil {
+		return nil, err
