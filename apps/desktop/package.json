{
  "name": "@warden/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run routes && tsc -b && vite build",
    "routes": "tsr generate",
    "typecheck": "pnpm run routes && tsc -b --noEmit",
    "lint": "pnpm run routes && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run routes && vitest run",
    "test:watch": "pnpm run routes && vitest",
    "test:coverage": "pnpm run routes && vitest run --coverage",
    "e2e": "cargo xtask e2e-driver && cargo tauri build --debug --no-bundle && wdio run ./wdio.conf.ts",
    "e2e:run": "wdio run ./wdio.conf.ts"
  },
  "dependencies": {
